rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    match /campaigns/{campaignId}/{folder}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && folder in ['progress', 'photos', 'receipts', 'verification'];
    }
  }
}
