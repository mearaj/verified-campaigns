rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isBootstrapSignup() {
      return isSignedIn()
        && !exists(/databases/$(database)/documents/settings/site);
    }

    function hasAdminGrant() {
      return isSignedIn()
        && request.auth.token.email != null
        && (
          exists(/databases/$(database)/documents/adminGrants/$(request.auth.token.email))
          || exists(/databases/$(database)/documents/adminGrants/$(request.auth.token.email.lower()))
        );
    }

    match /settings/site {
      allow read: if isSignedIn();
      allow create: if isBootstrapSignup();
      allow update, delete: if false;
    }

    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && (isBootstrapSignup() || hasAdminGrant());
      allow update, delete: if isAdmin();
    }

    match /adminGrants/{email} {
      allow read: if isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == email.lower();
      allow create: if isAdmin();
      allow delete: if isAdmin()
        || (isSignedIn()
          && request.auth.token.email != null
          && request.auth.token.email.lower() == email.lower());
    }

    match /organizers/{organizerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /campaigns/{campaignId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
